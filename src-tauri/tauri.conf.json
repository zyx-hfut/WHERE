{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WHERE",
  "version": "0.15.0",
  "identifier": "dev.where.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WHERE · 物品位置",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": "all",
    "category": "Utility",
    "shortDescription": "本地优先的物品位置记录工具",
    "longDescription": "WHERE 是一个开源、本地优先、支持双端同步的物品位置记录应用。"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2MjUwODYyNzQ5NkU4NEYKUldSUDZKWjBZZ2dsNXMvSnYxMFVxd2NuVXM5UFVhRmR2MFQwaGRBbWxENWk0ZHBrejJnWW9hU3MK",
      "endpoints": [
        "https://github.com/zyx-hfut/WHERE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
